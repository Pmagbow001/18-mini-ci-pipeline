# Local Docker Compose database settings. Keep DATABASE_URL on the Compose network.
POSTGRES_USER=minici
POSTGRES_PASSWORD=localdev
POSTGRES_DB=minici
DATABASE_URL=postgresql+psycopg://minici:localdev@db:5432/minici

# Comma-separated exact frontend origins; configure your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite proxy target: Compose uses the API service name; host Vite defaults to 127.0.0.1.
VITE_API_PROXY_TARGET=http://api:8000

# For a separately hosted static frontend, set VITE_API_URL at build time to the API URL.
# VITE_API_URL=
